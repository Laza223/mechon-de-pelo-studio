---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getContent } from '../lib/content';
import { whatsappUrl, defaultBookingMessage, igProfile } from '../lib/links';
const { settings } = await getContent();
const nav = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#trabajos', label: 'Trabajos' },
  { href: '/productos', label: 'Productos' },
  { href: '/#turnos', label: 'Turnos' },
];
---
<header class="header" data-header>
  <div class="header__inner">
    <a href="/" class="header__logo" aria-label="Mechón de Pelo, inicio">
      <Logo id="hdr" tagline={false} />
    </a>

    <nav class="header__nav" aria-label="Principal">
      <ul role="list">
        {nav.map((l) => <li><a class="link-underline" href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__actions">
      <button class="header__bag" type="button" data-bag-open aria-label="Abrir mi consulta de productos">
        <Icon name="bag" size={22} />
        <span class="header__bag-count" data-bag-count aria-hidden="true">0</span>
      </button>
      <a class="btn header__cta" href={whatsappUrl(settings, defaultBookingMessage)} target="_blank" rel="noopener" data-magnetic data-book-link>
        Reservá tu turno
      </a>
      <button class="header__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden">Menú</span>
        <span class="header__burger-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="menu" id="mobile-menu" data-menu hidden>
    <nav aria-label="Menú móvil">
      <ul role="list">
        {nav.map((l, i) => (
          <li><a href={l.href} data-menu-link><span class="menu__num">0{i + 1}</span>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="menu__foot">
      <a class="btn" href={whatsappUrl(settings, defaultBookingMessage)} target="_blank" rel="noopener">
        <Icon name="whatsapp" class="btn__icon" /> Reservá por WhatsApp
      </a>
      <a class="link-underline" href={igProfile(settings)} target="_blank" rel="noopener">@{settings.instagramHandle}</a>
      <span class="caps">{settings.zone}</span>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    color: var(--espresso);
    transition: transform 0.7s var(--ease-silk), color 0.5s;
  }
  .header::before {
    content: '';
    position: absolute; inset: 0;
    background: color-mix(in oklab, var(--ivory) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity 0.5s, background-color 0.5s;
  }
  :global(.header.is-scrolled)::before { opacity: 1; }
  :global(.header.is-hidden) { transform: translateY(-100%); }
  :global(.header.is-dark) { color: var(--ivory); }
  :global(.header.is-dark)::before { background: color-mix(in oklab, var(--ink) 70%, transparent); border-color: rgb(247 242 236 / 0.08); }
  :global(.header.is-dark .logo) { color: var(--ivory); }
  :global(.header.is-dark .header__cta) { --btn-bg: var(--ivory); --btn-fg: var(--ink); }

  .header__inner {
    position: relative;
    height: 100%;
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }
  .header__logo { justify-self: start; }
  .header__logo :global(.logo) { --logo-size: 0.62rem; transition: color 0.5s; }
  .header__logo :global(.logo__swoosh) { width: 62%; margin-bottom: -0.35em; }

  .header__nav ul { display: flex; gap: clamp(1.5rem, 3vw, 3rem); }
  .header__nav a { font-size: var(--fs-xs); letter-spacing: 0.24em; text-transform: uppercase; font-weight: 400; }

  .header__actions { justify-self: end; display: flex; align-items: center; gap: 1rem; }
  .header__cta { padding: 0.9em 1.4em; }
  .header__bag {
    position: relative; width: 44px; height: 44px; display: grid; place-items: center;
    border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line);
  }
  .header__bag-count {
    position: absolute; top: -2px; right: -2px;
    min-width: 18px; height: 18px; padding: 0 4px;
    display: grid; place-items: center;
    background: var(--gold-2); color: var(--ink);
    font-size: 10px; font-weight: 500; border-radius: 999px;
    transform: scale(0); transition: transform 0.4s var(--ease-out);
  }
  :global(.header__bag-count.has-items) { transform: scale(1); }

  .header__burger { display: none; width: 44px; height: 44px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line); place-items: center; }
  .header__burger-lines { display: grid; gap: 6px; width: 18px; }
  .header__burger-lines i { display: block; height: 1px; background: currentColor; transition: transform 0.5s var(--ease-silk); }
  .header__burger[aria-expanded='true'] i:first-child { transform: translateY(3.5px) rotate(45deg); }
  .header__burger[aria-expanded='true'] i:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .menu {
    position: fixed; inset: 0; z-index: -1;
    background: var(--ivory);
    padding: calc(var(--header-h) + 3rem) var(--gutter) 2.5rem;
    display: flex; flex-direction: column; justify-content: space-between;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.8s var(--ease-silk);
  }
  :global(.menu.is-open) { clip-path: inset(0 0 0 0); }
  .menu ul { display: grid; gap: 0.6rem; }
  .menu a[data-menu-link] {
    display: flex; align-items: baseline; gap: 1rem;
    font-family: var(--font-display); font-size: clamp(2.6rem, 12vw, 4.5rem); line-height: 1.05;
  }
  .menu__num { font-family: var(--font-sans); font-size: var(--fs-xs); letter-spacing: 0.2em; color: var(--mocha); }
  .menu__foot { display: grid; gap: 1.2rem; justify-items: start; }

  @media (max-width: 960px) {
    .header__inner { grid-template-columns: 1fr auto; }
    .header__nav, .header__cta { display: none; }
    .header__burger { display: grid; }
  }
</style>
