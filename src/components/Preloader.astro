---
import Swoosh from './Swoosh.astro';
---
<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__logo">
    <Swoosh id="pre" class="preloader__swoosh" draw />
    <p class="preloader__word" data-pre-word>Mechón <span>de</span> Pelo</p>
    <p class="preloader__tag" data-pre-tag>Hair Studio</p>
  </div>
  <p class="preloader__count"><span data-pre-count>0</span><sup>%</sup></p>
  <p class="preloader__place caps">Luján · Buenos Aires</p>
</div>
<script is:inline>
  // Revisita en la misma sesión: sin preloader largo.
  try { if (sessionStorage.getItem('mdp-visited')) document.documentElement.classList.add('is-revisit'); } catch (e) {}
</script>
<style>
  .preloader {
    position: fixed; inset: 0; z-index: 70;
    display: none;
    place-items: center;
    background: var(--ivory);
    color: var(--espresso);
  }
  :global(.has-js) .preloader { display: grid; }
  :global(.has-js.no-motion) .preloader, :global(.has-js.is-revisit) .preloader { display: none; }
  .preloader__logo { display: grid; justify-items: center; width: min(78vw, 640px); }
  .preloader__logo :global(.preloader__swoosh) { width: 74%; margin-left: 8%; margin-bottom: -1.2rem; }
  .preloader__word {
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(2.8rem, 9vw, 6.2rem); line-height: 1; letter-spacing: -0.02em; white-space: nowrap;
  }
  .preloader__word span { font-size: 0.56em; }
  .preloader__tag {
    margin-top: 1.2rem; font-size: clamp(0.7rem, 1.4vw, 0.95rem);
    letter-spacing: 0.9em; margin-right: -0.9em; text-transform: uppercase;
  }
  .preloader__count {
    position: absolute; right: var(--gutter); bottom: 2rem;
    font-family: var(--font-display); font-size: clamp(3rem, 7vw, 6rem); line-height: 1; font-weight: 300;
    font-variant-numeric: tabular-nums;
  }
  .preloader__count sup { font-size: 0.3em; vertical-align: top; margin-left: 0.2em; font-family: var(--font-sans); }
  .preloader__place { position: absolute; left: var(--gutter); bottom: 2.6rem; color: var(--mocha); }
</style>
