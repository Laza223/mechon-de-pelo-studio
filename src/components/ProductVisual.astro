---
/**
 * Packshot ilustrado (SVG) para productos sin foto todavía.
 * Mantiene la estética de estudio: luz lateral, sombra suave, volumen cilíndrico.
 */
import type { ProductVisual } from '../lib/types';
interface Props {
  uid: string;
  visual: { kind: ProductVisual; color: string; accent?: string; label?: string };
  brand?: string;
  class?: string;
}
const { uid, visual, brand = '', class: cls } = Astro.props;
const { kind, color, accent = '#f4ede6', label = '' } = visual;
const id = `pv-${uid}`;
const light = (hex: string) => {
  const n = parseInt(hex.replace('#', ''), 16);
  const r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
  return 0.299 * r + 0.587 * g + 0.114 * b > 160;
};
const ink = light(color) ? '#2e2019' : '#fbf6ef';
const brandUp = brand.toUpperCase();
---
<svg class:list={['pv', cls]} viewBox="0 0 300 400" role="img" aria-label={`Ilustración de ${label || kind}`} data-product-visual>
  <defs>
    <linearGradient id={`${id}-cyl`} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#000" stop-opacity=".38" />
      <stop offset=".16" stop-color="#000" stop-opacity=".05" />
      <stop offset=".3" stop-color="#fff" stop-opacity=".42" />
      <stop offset=".38" stop-color="#fff" stop-opacity=".06" />
      <stop offset=".75" stop-color="#000" stop-opacity=".08" />
      <stop offset="1" stop-color="#000" stop-opacity=".42" />
    </linearGradient>
    <linearGradient id={`${id}-cap`} x1="0" x2="1">
      <stop offset="0" stop-color="#0d0907" />
      <stop offset=".3" stop-color="#4a3c33" />
      <stop offset=".45" stop-color="#1c1410" />
      <stop offset="1" stop-color="#050302" />
    </linearGradient>
    <linearGradient id={`${id}-gold`} x1="0" x2="1">
      <stop offset="0" stop-color="#7a5a2e" />
      <stop offset=".3" stop-color="#ead7ae" />
      <stop offset=".55" stop-color="#b8904f" />
      <stop offset="1" stop-color="#6d4f27" />
    </linearGradient>
    <radialGradient id={`${id}-shadow`} cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#2e2019" stop-opacity=".35" />
      <stop offset="1" stop-color="#2e2019" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={`${id}-glass`} x1="0" x2="1">
      <stop offset="0" stop-color={color} stop-opacity=".95" />
      <stop offset=".3" stop-color="#fff" stop-opacity=".55" />
      <stop offset=".42" stop-color={color} stop-opacity=".75" />
      <stop offset="1" stop-color={color} />
    </linearGradient>
  </defs>

  <ellipse cx="150" cy="372" rx="104" ry="14" fill={`url(#${id}-shadow)`} />

  {kind === 'jar' && (
    <g>
      <rect x="52" y="182" width="196" height="186" rx="22" fill={color} />
      <rect x="52" y="182" width="196" height="186" rx="22" fill={`url(#${id}-cyl)`} />
      <rect x="44" y="118" width="212" height="74" rx="18" fill={color} />
      <rect x="44" y="118" width="212" height="74" rx="18" fill={`url(#${id}-cyl)`} />
      <rect x="44" y="184" width="212" height="6" fill="#000" opacity=".18" />
      <text x="150" y="262" text-anchor="middle" fill={ink} font-family="Jost, sans-serif" font-size="26" font-weight="500" letter-spacing="1">{label}</text>
      <rect x="92" y="278" width="116" height="1.5" fill={ink} opacity=".5" />
      <text x="150" y="300" text-anchor="middle" fill={ink} font-family="Jost, sans-serif" font-size="9" letter-spacing="3" opacity=".75">{brandUp}</text>
    </g>
  )}

  {kind === 'tube' && (
    <g>
      <path d="M82 46 H218 L212 300 Q150 312 88 300 Z" fill={color} />
      <path d="M82 46 H218 L212 300 Q150 312 88 300 Z" fill={`url(#${id}-cyl)`} />
      <rect x="80" y="38" width="140" height="16" rx="3" fill={color} />
      <rect x="80" y="38" width="140" height="16" rx="3" fill="#000" opacity=".12" />
      <rect x="110" y="300" width="80" height="66" rx="8" fill={accent === '#151012' ? `url(#${id}-cap)` : accent} />
      <rect x="110" y="300" width="80" height="66" rx="8" fill={`url(#${id}-cyl)`} opacity=".6" />
      <text x="150" y="104" text-anchor="middle" fill={ink} font-family="Jost, sans-serif" font-size="11" letter-spacing="3" opacity=".85">{brandUp}</text>
      <text x="150" y="150" text-anchor="middle" fill={ink} font-family="Cormorant Garamond, serif" font-size="30" font-weight="600" letter-spacing="1">{label}</text>
      <rect x="104" y="164" width="92" height="1.2" fill={ink} opacity=".5" />
    </g>
  )}

  {kind === 'bottle' && (
    <g>
      <rect x="126" y="62" width="48" height="44" rx="6" fill={`url(#${id}-gold)`} />
      <rect x="134" y="100" width="32" height="22" fill={color} />
      <path d="M134 120 C 96 132 88 150 88 172 V 352 Q 88 368 104 368 H 196 Q 212 368 212 352 V 172 C 212 150 204 132 166 120 Z" fill={color} />
      <path d="M134 120 C 96 132 88 150 88 172 V 352 Q 88 368 104 368 H 196 Q 212 368 212 352 V 172 C 212 150 204 132 166 120 Z" fill={`url(#${id}-cyl)`} />
      <rect x="100" y="210" width="100" height="110" rx="4" fill={accent} opacity=".9" />
      <text x="150" y="262" text-anchor="middle" fill="#2e2019" font-family="Cormorant Garamond, serif" font-size="28" font-weight="600">{label}</text>
      <text x="150" y="285" text-anchor="middle" fill="#2e2019" font-family="Jost, sans-serif" font-size="8" letter-spacing="2.5" opacity=".7">{brandUp}</text>
    </g>
  )}

  {kind === 'spray' && (
    <g>
      <path d="M128 58 H176 Q186 58 186 70 V 80 H 198 Q 204 80 204 86 V 92 H 186 V 108 H 128 Z" fill={`url(#${id}-cap)`} />
      <rect x="130" y="106" width="44" height="26" rx="3" fill={`url(#${id}-cap)`} />
      <path d="M132 130 C 104 140 100 152 100 172 V 354 Q 100 368 114 368 H 190 Q 204 368 204 354 V 172 C 204 152 200 140 172 130 Z" fill={color} />
      <path d="M132 130 C 104 140 100 152 100 172 V 354 Q 100 368 114 368 H 190 Q 204 368 204 354 V 172 C 204 152 200 140 172 130 Z" fill={`url(#${id}-cyl)`} />
      <text x="152" y="214" text-anchor="middle" fill={accent} font-family="Cormorant Garamond, serif" font-size="22" font-weight="600" letter-spacing="3">{label}</text>
      <rect x="122" y="226" width="60" height="1" fill={accent} opacity=".6" />
      <text x="152" y="338" text-anchor="middle" fill={accent} font-family="Jost, sans-serif" font-size="9" letter-spacing="2.5" opacity=".85">{brandUp}</text>
    </g>
  )}

  {kind === 'dropper' && (
    <g>
      <path d="M134 56 Q 150 40 166 56 V 108 H 134 Z" fill="#1c1410" />
      <rect x="126" y="104" width="48" height="30" rx="4" fill={`url(#${id}-gold)`} />
      <path d="M120 134 H180 Q 212 146 212 186 V 352 Q 212 368 196 368 H 104 Q 88 368 88 352 V 186 Q 88 146 120 134 Z" fill={`url(#${id}-glass)`} />
      <path d="M120 134 H180 Q 212 146 212 186 V 352 Q 212 368 196 368 H 104 Q 88 368 88 352 V 186 Q 88 146 120 134 Z" fill={`url(#${id}-cyl)`} opacity=".6" />
      <rect x="100" y="232" width="100" height="84" rx="3" fill={accent} />
      <text x="150" y="272" text-anchor="middle" fill="#fff" font-family="Jost, sans-serif" font-size="13" font-weight="500" letter-spacing="2">{label}</text>
      <text x="150" y="294" text-anchor="middle" fill="#fff" font-family="Jost, sans-serif" font-size="7" letter-spacing="2" opacity=".8">{brandUp}</text>
    </g>
  )}

  {kind === 'bonnet' && (
    <g>
      <path d="M44 300 C 36 150 110 96 160 98 C 220 100 270 160 258 300 Z" fill={color} />
      <path d="M44 300 C 36 150 110 96 160 98 C 220 100 270 160 258 300 Z" fill={`url(#${id}-cyl)`} opacity=".7" />
      <path d="M80 170 C 120 130 200 128 236 180" stroke="#fff" stroke-opacity=".5" stroke-width="10" fill="none" stroke-linecap="round" />
      <path d="M70 220 C 120 190 196 188 246 230" stroke="#fff" stroke-opacity=".22" stroke-width="16" fill="none" stroke-linecap="round" />
      <path d="M34 296 C 100 330 200 330 268 296 L 266 322 C 200 352 100 352 36 322 Z" fill={accent} />
      <path d="M34 296 C 100 330 200 330 268 296 L 266 322 C 200 352 100 352 36 322 Z" fill={`url(#${id}-cyl)`} opacity=".5" />
    </g>
  )}

  {kind === 'brush' && (
    <g>
      <g stroke={accent} stroke-width="12" stroke-linecap="round">
        <path d="M100 330 V 300" /><path d="M128 340 V 305" /><path d="M156 342 V 306" /><path d="M184 340 V 305" /><path d="M210 330 V 300" />
        <path d="M114 300 V 270" /><path d="M142 306 V 276" /><path d="M170 306 V 276" /><path d="M198 300 V 270" />
      </g>
      <path d="M70 290 C 70 190 230 190 230 290 Z" fill={color} />
      <path d="M70 290 C 70 190 230 190 230 290 Z" fill={`url(#${id}-cyl)`} opacity=".7" />
      <ellipse cx="150" cy="290" rx="82" ry="12" fill={color} />
      <ellipse cx="150" cy="290" rx="82" ry="12" fill="#000" opacity=".1" />
      <path d="M118 232 C 128 215 172 214 182 232" stroke="#fff" stroke-opacity=".55" stroke-width="7" fill="none" stroke-linecap="round" />
    </g>
  )}
</svg>
<style>
  .pv { width: 100%; height: 100%; overflow: visible; }
</style>
