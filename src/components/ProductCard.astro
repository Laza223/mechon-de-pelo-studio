---
import Media from './Media.astro';
import ProductVisual from './ProductVisual.astro';
import Icon from './Icon.astro';
import type { Product } from '../lib/types';
import { ars, stockLabel } from '../lib/format';
interface Props { product: Product; tone?: 'light' | 'dark'; headingLevel?: 'h3' | 'h2' }
const { product: p, tone = 'light', headingLevel: H = 'h3' } = Astro.props;
const disabled = p.stock === 'agotado';
---
<article class:list={['pcard', `pcard--${tone}`, { 'is-out': disabled }]} data-product-card data-cat={p.category} data-reveal="up">
  <a class="pcard__visual" href={`/productos/${p.slug}`} data-cursor="Ver" aria-label={`Ver ${p.name}`}>
    <span class="pcard__stage">
      {p.image ? (
        <Media img={p.image} class="pcard__img" sizes="(min-width: 900px) 25vw, 50vw" />
      ) : p.visual ? (
        <ProductVisual uid={p.id} visual={p.visual} brand={p.brand} />
      ) : null}
    </span>
    <span class:list={['pcard__stock', `is-${p.stock}`]}>{stockLabel[p.stock]}</span>
  </a>
  <div class="pcard__body">
    {p.brand && <p class="pcard__brand caps">{p.brand}</p>}
    <H class="pcard__name"><a href={`/productos/${p.slug}`}>{p.name}</a></H>
    <p class="pcard__desc">{p.description}</p>
    <div class="pcard__foot">
      <span class="pcard__price">{p.showPrice && p.price ? ars(p.price) : 'Consultá precio'}</span>
      <button
        type="button"
        class="pcard__add"
        data-bag-add={p.id}
        disabled={disabled}
        aria-label={disabled ? `${p.name} agotado` : `Sumar ${p.name} a mi consulta`}
      >
        <Icon name="plus" size={18} />
        <span>{disabled ? 'Agotado' : 'Sumar'}</span>
      </button>
    </div>
  </div>
</article>

<style>
  .pcard { display: grid; gap: 1.2rem; align-content: start; }
  .pcard__visual {
    position: relative; display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    background:
      radial-gradient(120% 80% at 30% 15%, #fffaf3 0%, transparent 55%),
      linear-gradient(160deg, #f1e8de 0%, #e4d6c8 100%);
    overflow: hidden;
  }
  .pcard--dark .pcard__visual {
    background:
      radial-gradient(120% 80% at 30% 15%, rgb(234 215 174 / 0.16) 0%, transparent 55%),
      linear-gradient(160deg, #2b1f19 0%, #1a120e 100%);
    box-shadow: inset 0 0 0 1px rgb(247 242 236 / 0.06);
  }
  .pcard__stage {
    position: absolute; inset: 10% 14% 6%;
    transition: transform 0.9s var(--ease-out);
  }
  .pcard__stage :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .pcard__visual:hover .pcard__stage { transform: translateY(-3%) scale(1.04) rotate(-1.5deg); }
  .pcard__stock {
    position: absolute; top: 1rem; left: 1rem;
    padding: 0.4em 0.9em; border-radius: 999px;
    font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase;
    background: rgb(251 248 244 / 0.86); color: var(--espresso);
    backdrop-filter: blur(6px);
    display: inline-flex; align-items: center; gap: 0.5em;
  }
  .pcard__stock::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #6d8b5a; }
  .pcard__stock.is-consultar::before { background: var(--gold-2); }
  .pcard__stock.is-agotado::before { background: #a24a3c; }
  .is-out .pcard__stage { opacity: 0.5; filter: grayscale(0.6); }

  .pcard__body { display: grid; gap: 0.45rem; }
  .pcard__brand { font-size: 0.64rem; color: var(--mocha); }
  .pcard--dark .pcard__brand { color: var(--gold-2); }
  .pcard__name { font-size: var(--fs-xl); font-weight: 400; line-height: 1.05; }
  .pcard__desc { font-size: var(--fs-sm); color: var(--fg-soft); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pcard__foot { display: flex; justify-content: space-between; align-items: center; padding-top: 0.8rem; margin-top: 0.3rem; border-top: 1px solid var(--line); }
  .pcard__price { font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-soft); }
  .pcard__add {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.55em 1em 0.55em 0.8em; border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: var(--fs-xs); letter-spacing: 0.16em; text-transform: uppercase;
    transition: background-color 0.4s, color 0.4s;
  }
  .pcard__add:hover:not(:disabled) { background: var(--espresso); color: var(--ivory); }
  .pcard--dark .pcard__add:hover:not(:disabled) { background: var(--ivory); color: var(--ink); }
  .pcard__add:disabled { opacity: 0.5; cursor: not-allowed; }
  .pcard__add.is-added { background: var(--gold-2); color: var(--ink); box-shadow: none; }
</style>
