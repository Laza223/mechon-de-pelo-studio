---
import Media from './Media.astro';
import Icon from './Icon.astro';
import { getContent } from '../lib/content';
import { igProfile } from '../lib/links';
const { gallery, settings } = await getContent();
const filters = [
  { key: 'todos', label: 'Todos' },
  { key: 'peinados', label: 'Peinados' },
  { key: 'tratamientos', label: 'Tratamientos' },
  { key: 'trenzas', label: 'Trenzas' },
];
const catLabel: Record<string, string> = { peinados: 'Peinados', tratamientos: 'Tratamientos', trenzas: 'Trenzas africanas' };
---
<section class="gallery section" id="trabajos" aria-labelledby="gallery-title" data-gallery>
  <div class="container">
    <div class="gallery__head">
      <div class="section-head">
        <p class="eyebrow" data-reveal="fade">Trabajos</p>
        <h2 id="gallery-title" data-split="lines">Hecho a mano,<br /> <em>mechón por mechón.</em></h2>
      </div>
      <div class="gallery__filters" role="group" aria-label="Filtrar trabajos" data-reveal="fade">
        {filters.map((f, i) => (
          <button type="button" class="gallery__filter" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={f.key}>{f.label}</button>
        ))}
      </div>
    </div>

    <ul role="list" class="gallery__grid" data-gallery-grid>
      {gallery.map((g, i) => (
        <li class:list={['tile', g.image ? 'tile--photo' : 'tile--quote', `tile--${(i % 5) + 1}`]} data-cat={g.category} data-tile>
          {g.image ? (
            <button type="button" class="tile__inner" data-lightbox data-cursor="Ver" aria-label={`Ampliar: ${g.caption}`}>
              <span class="tile__media" data-parallax-wrap>
                <Media img={g.image} class="tile__img" sizes="(min-width: 900px) 33vw, 90vw" />
              </span>
              <span class="tile__caption">
                <span class="caps">{catLabel[g.category]}</span>
                <span class="tile__title">{g.caption}</span>
              </span>
            </button>
          ) : (
            <div class="tile__inner tile__inner--quote">
              <span class="caps">{catLabel[g.category]}</span>
              <p class="tile__quote">{g.quote}</p>
              <span class="tile__title">{g.caption}</span>
            </div>
          )}
        </li>
      ))}
      <li class="tile tile--cta" data-cat="todos" data-tile>
        <a class="tile__inner tile__inner--cta" href={igProfile(settings)} target="_blank" rel="noopener">
          <Icon name="instagram" size={30} />
          <span class="tile__title">Más trabajos en <br />@{settings.instagramHandle}</span>
          <span class="tile__arrow"><Icon name="arrow" /></span>
        </a>
      </li>
    </ul>
  </div>

  <dialog class="lightbox" data-lightbox-dialog aria-label="Imagen ampliada">
    <button class="lightbox__close" type="button" data-lightbox-close aria-label="Cerrar"><Icon name="close" /></button>
    <figure>
      <img data-lightbox-img alt="" />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
  </dialog>
</section>

<style>
  .gallery__head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .gallery__head .section-head { margin: 0; }
  .gallery__head h2 { font-weight: 300; }
  .gallery__filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .gallery__filter {
    padding: 0.7em 1.3em; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line);
    font-size: var(--fs-xs); letter-spacing: 0.18em; text-transform: uppercase;
    transition: background-color 0.4s, color 0.4s;
  }
  .gallery__filter[aria-pressed='true'] { background: var(--espresso); color: var(--ivory); box-shadow: none; }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: clamp(120px, 11vw, 170px);
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
  }
  .tile { position: relative; grid-column: span 4; grid-row: span 3; }
  .tile--1 { grid-column: span 5; grid-row: span 4; }
  .tile--2 { grid-column: span 4; grid-row: span 2; }
  .tile--3 { grid-column: span 3; grid-row: span 3; }
  .tile--4 { grid-column: span 4; grid-row: span 2; }
  .tile--5 { grid-column: span 3; grid-row: span 2; }
  .tile--cta { grid-column: span 4; grid-row: span 2; }
  .tile.is-hidden { display: none; }

  .tile__inner {
    position: relative; width: 100%; height: 100%;
    display: block; overflow: hidden;
    border-radius: var(--radius);
    text-align: left;
  }
  .tile__media { position: absolute; inset: 0; overflow: hidden; }
  .tile__media :global(picture) { display: block; width: 100%; height: 100%; }
  .tile__media :global(img) {
    width: 100%; height: 118%; object-fit: cover; display: block;
    transition: scale 1.2s var(--ease-out);
  }
  .tile--photo:hover .tile__media :global(img) { scale: 1.05; }
  .tile__caption {
    position: absolute; inset: auto 0 0 0;
    padding: 1.4rem;
    display: grid; gap: 0.3rem;
    color: var(--ivory);
    background: linear-gradient(transparent, rgb(28 20 16 / 0.65));
  }
  .tile__caption .caps { font-size: 0.62rem; opacity: 0.85; }
  .tile__title { font-family: var(--font-display); font-size: var(--fs-lg); line-height: 1.1; }

  .tile__inner--quote {
    background: var(--sand);
    padding: clamp(1.25rem, 2vw, 2rem);
    display: grid; align-content: space-between; gap: 1rem;
  }
  .tile__inner--quote .caps { color: var(--mocha); }
  .tile__quote { font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: var(--fs-xl); line-height: 1.12; }
  .tile--4 .tile__inner--quote { background: var(--espresso); color: var(--ivory); }
  .tile--4 .tile__inner--quote .caps { color: var(--gold-2); }

  .tile__inner--cta {
    display: grid; align-content: space-between; padding: clamp(1.25rem, 2vw, 2rem);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background-color 0.5s;
  }
  .tile__inner--cta:hover { background: var(--sand); }
  .tile__arrow { justify-self: end; transition: transform 0.5s var(--ease-out); }
  .tile__inner--cta:hover .tile__arrow { transform: translateX(6px); }

  @media (max-width: 900px) {
    .gallery__grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 42vw; }
    .tile, .tile--1, .tile--2, .tile--3, .tile--4, .tile--5, .tile--cta { grid-column: span 1; grid-row: span 1; }
    .tile--1 { grid-column: span 2; grid-row: span 2; }
    .tile--4, .tile--cta { grid-column: span 2; }
  }

  .lightbox {
    border: 0; padding: 0; background: transparent; max-width: 92vw; max-height: 92vh; margin: auto;
    overflow: visible;
  }
  .lightbox::backdrop { background: rgb(28 20 16 / 0.85); backdrop-filter: blur(6px); }
  .lightbox img { max-height: 82vh; width: auto; border-radius: var(--radius-sm); }
  .lightbox figcaption { color: var(--ivory); text-align: center; margin-top: 1rem; font-family: var(--font-display); font-size: var(--fs-lg); }
  .lightbox__close {
    position: absolute; top: -56px; right: 0; width: 44px; height: 44px; border-radius: 50%;
    display: grid; place-items: center; color: var(--ivory); box-shadow: inset 0 0 0 1px rgb(247 242 236 / 0.3);
  }
</style>
