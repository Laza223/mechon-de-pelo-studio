---
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '@fontsource/allura/latin-400.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BagDrawer from '../components/BagDrawer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { getContent } from '../lib/content';
import { igProfile } from '../lib/links';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** La home monta el preloader y la escena 3D completa. */
  home?: boolean;
  bodyClass?: string;
}
const { settings, products } = await getContent();
const {
  title = settings.seoTitle,
  description = settings.seoDescription,
  image = '/og.jpg',
  home = false,
  bodyClass = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: 'Mechón de Pelo | Hair Studio',
  description: settings.seoDescription,
  url: Astro.site?.toString(),
  image: ogImage.toString(),
  areaServed: { '@type': 'City', name: 'Luján', containedInPlace: { '@type': 'State', name: 'Buenos Aires' } },
  address: { '@type': 'PostalAddress', addressLocality: 'Luján', addressRegion: 'Buenos Aires', addressCountry: 'AR' },
  sameAs: [igProfile(settings)],
  priceRange: '$$',
  makesOffer: [
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Peinados para eventos' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Alisados' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Nutriciones capilares' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Trenzas africanas' } },
  ],
};

// Catálogo mínimo para la bolsita (nombre + slug), disponible en todas las páginas.
const bagCatalog = products.map((p) => ({ id: p.id, name: p.name, brand: p.brand ?? '', slug: p.slug }));
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f7f2ec" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Mechón de Pelo | Hair Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      // Progressive enhancement: el contenido es visible sin JS; con JS se anima.
      (function () {
        var d = document.documentElement;
        d.classList.add('has-js');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('no-motion');
        // Red de seguridad: si el bundle no arranca, mostramos todo igual.
        setTimeout(function () { if (!d.classList.contains('is-booted')) d.classList.add('no-motion'); }, 6000);
      })();
    </script>
  </head>
  <body
    class={bodyClass}
    data-home={home ? '' : undefined}
    data-wa-number={settings.whatsappNumber ?? ''}
    data-wa-link={settings.whatsappLink}
    data-ig={settings.instagramHandle}
  >
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    {home && <div class="gl-stage" data-gl-stage aria-hidden="true"></div>}

    <Header />

    <div class="page">
      <main id="contenido">
        <slot />
      </main>
      <Footer />
    </div>

    <BagDrawer />
    <WhatsAppFab />

    <div class="cursor" aria-hidden="true" data-cursor>
      <div class="cursor__ring"><span class="cursor__label" data-cursor-label>Ver</span></div>
      <div class="cursor__dot"></div>
    </div>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <div class="grain" aria-hidden="true"></div>

    <script type="application/json" id="bag-catalog" set:html={JSON.stringify(bagCatalog)} />
    <script>
      import { boot } from '../scripts/app';
      boot();
    </script>
  </body>
</html>
